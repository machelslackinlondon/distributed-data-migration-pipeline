{
  "name": "distributed-data-migration-pipeline",
  "version": "1.0.0",
  "description": "A bounded, observable data migration pipeline with safe replay and reconciliation.",
  "type": "module",
  "private": false,
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "tsx watch src/index.ts",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint .",
    "load:test": "tsx scripts/load-test.ts",
    "start": "node dist/index.js",
    "test": "node --experimental-vm-modules ./node_modules/jest/bin/jest.js",
    "test:coverage": "node --experimental-vm-modules ./node_modules/jest/bin/jest.js --coverage",
    "test:watch": "node --experimental-vm-modules ./node_modules/jest/bin/jest.js --watch",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "verify": "npm run format:check && npm run lint && npm run typecheck && npm test && npm run build"
  },
  "dependencies": {
    "@prometheus-io/client": "0.16.1",
    "better-sqlite3": "13.0.3",
    "fastify": "5.12.5",
    "pino": "10.4.0",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/better-sqlite3": "9.6.0",
    "@types/node": "26.6.5",
    "autocannon": "8.0.0",
    "eslint": "10.10.0",
    "jest": "30.5.2",
    "prettier": "3.6.2",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.1"
  }
}
